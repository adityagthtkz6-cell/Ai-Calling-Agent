# ============================================================
# Voice Intelligence Platform — Environment Variables
# Copy to .env.local and fill in values before running.
# NEVER commit .env.local to git.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Redis (Upstash recommended for serverless; self-hosted also works)
REDIS_URL=redis://localhost:6379

# OpenAI (embeddings: text-embedding-3-small, agents: gpt-4.1-mini)
OPENAI_API_KEY=sk-your-openai-key-here

# Retell AI
RETELL_API_KEY=your-retell-api-key-here
RETELL_WEBHOOK_SECRET=your-retell-webhook-secret-here

# n8n (self-hosted on Hostinger VPS)
N8N_BASE_URL=https://your-n8n-instance.com
N8N_API_KEY=your-n8n-api-key-here

# Telegram (for cost runaway + webhook failure alerts)
# 1. Message @BotFather → /newbot → copy token
# 2. Get chat_id: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Anthropic (Qualifier + Knowledge agents use Claude Haiku)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Ingestion API (protects /api/ingest and /api/brain-dump)
INGEST_API_KEY=generate-a-random-32-char-secret-here
# Exposed to browser for dashboard brain-dump form (same value as above)
NEXT_PUBLIC_INGEST_API_KEY=generate-a-random-32-char-secret-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
